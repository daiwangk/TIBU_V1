# Frontend (Vite) — safe to expose: the anon key is public by design, RLS protects data
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
VITE_SITE_URL=http://localhost:5173

# NEVER put these in the frontend or commit them:
# SUPABASE_SERVICE_ROLE_KEY=...   (CI / scripts only)
# SUPABASE_DB_PASSWORD=...
# RESEND_API_KEY=...              (set inside Supabase Auth SMTP settings, not here)
