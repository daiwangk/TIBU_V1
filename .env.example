# Copy to .env.local (never commit .env.local). Every VITE_* value is shipped to the browser.
VITE_DATA_SOURCE=mock                 # mock | supabase
VITE_SITE_URL=http://localhost:5173   # used in WhatsApp message links and auth redirects
VITE_SUPABASE_URL=https://<dev-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon or publishable key — public by design, protected by RLS>
VITE_VAPID_PUBLIC_KEY=<public VAPID key — set in R5>

# NEVER put the service-role / secret key here. The seed script reads it from .env.seed (git-ignored).

# Cloudflare Pages Functions (link previews, functions/) read RUNTIME variables set in the Pages dashboard,
# not the VITE_* ones: SUPABASE_URL, SUPABASE_ANON_KEY (public anon key only), SITE_URL. See docs/build/og-testing.md.
